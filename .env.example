# ============================================================================
#  BunkrDownloader · 环境变量示例
#
#  复制为 .env 后按需修改；所有变量都有内置默认值，留空即用默认。
#  Docker Compose 会自动读取同目录的 .env。
# ============================================================================

# ------------------------------------------------------------------- 服务
BUNKR_HOST=0.0.0.0
BUNKR_PORT=8765
BUNKR_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# 允许的跨域来源；"*" 表示任意（仅在需要被其他前端调用时保留）
BUNKR_ALLOW_ORIGIN=*

# ------------------------------------------------------------------- 存储
# SQLite 数据库与 aria2 会话文件所在目录
BUNKR_DATA_DIR=./.bunkr_data
# 下载文件的保存目录
BUNKR_DOWNLOAD_DIR=./downloads
# 数据库文件路径（默认 $BUNKR_DATA_DIR/bunkr.db）
# BUNKR_DB=./.bunkr_data/bunkr.db

# ------------------------------------------------------------- 账号与配额
# JWT 签名密钥。留空时会自动生成并保存到 $BUNKR_DATA_DIR/.jwt_secret
# 生产环境请显式设置（建议 32 位以上随机串）
# BUNKR_JWT_SECRET=change-me-to-a-long-random-string
BUNKR_JWT_TTL=720h                    # 令牌有效期，支持 Go duration 或纯天数

# 免费用户额度
BUNKR_FREE_LINKS_LIMIT=5              # 最多添加的链接数
BUNKR_FREE_FILES_LIMIT=50             # 最多下载的文件数
BUNKR_FREE_CONCURRENCY=1              # 同时运行的任务数

# 会员额度
BUNKR_MEMBER_CONCURRENCY=5

# ------------------------------------------------------------------- aria2
BUNKR_ARIA2_ENABLED=true
# 显式指定 aria2c 路径；留空时按顺序查找：$BUNKR_DATA_DIR/aria2 → PATH → 自动下载
# BUNKR_ARIA2_BIN=/usr/bin/aria2c
# 找不到时是否自动下载官方二进制（Windows / macOS 有效；Linux 需用包管理器安装）
BUNKR_ARIA2_AUTO_FETCH=true
BUNKR_ARIA2_HOST=127.0.0.1            # aria2c RPC 监听地址
BUNKR_ARIA2_PORT=6800
BUNKR_ARIA2_SECRET=bunkr              # RPC 密钥
BUNKR_ARIA2_MAX_CONCURRENT=16         # 全局同时下载数

# ---------------------------------------------------------------- 会员支付
# true：点击「立即开通」后模拟网关直接置为已支付（演示用）
# false：订单保持 pending，需要手动回调
BUNKR_PAYMENT_AUTO=true

# ------------------------------------------------------------ Bunkr 接口
# 默认使用官方服务；如需对接镜像可覆盖以下三项
# BUNKR_SIGN_API=https://glb-apisign.cdn.cr/sign
# BUNKR_DOWNLOAD_API=https://dl.bunkr.cr/api/_001_v2
# BUNKR_DOWNLOAD_REFERER=https://dl.bunkrr.cr/
# 抓取页面时使用的 User-Agent
# BUNKR_USER_AGENT=Mozilla/5.0 (X11; Ubuntu; Linux x86_64; rv:136.0) Gecko/20100101 Firefox/136.0

# ------------------------------------------------------------------- 其它
TZ=Asia/Shanghai
