# Normalise line endings so shell scripts and Dockerfiles stay LF in the repo
# and work correctly inside Linux containers.
* text=auto eol=lf

*.go   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.env.example    text eol=lf

# Binary assets must never be rewritten.
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.exe  binary
*.db   binary
