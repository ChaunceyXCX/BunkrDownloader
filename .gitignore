# ============================================================================
#  Patterns are root-anchored (leading slash) on purpose: a bare "downloads/"
# would also match internal/downloads/, which is source code.
# ============================================================================

# ---- Go build artifacts ----
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# ---- generated / embedded SPA (built by `make web`) ----
/internal/web/dist/*
!/internal/web/dist/.gitkeep
/frontend/dist/
/frontend/.vite/

# ---- dependencies ----
/frontend/node_modules/
npm-debug.log*

# ---- runtime data (always root-anchored) ----
/.bunkr_data/
/data/
/downloads/
/.shot/
/.icon/
*.db
*.db-shm
*.db-wal
*.log
aria2-session.txt
aria2.log
aria2.log.out

# ---- env & secrets ----
/.env
/.env.local
!/.env.example
!/.env.desktop.example
.jwt_secret

# ---- editors / OS ----
/.vscode/
/.idea/
/.kilo/
/**/.DS_Store
Thumbs.db
*.swp