# ============================================================================
#  BunkrDownloader · 桌面版环境变量示例
#
#  桌面应用无需任何环境变量即可运行：路径由操作系统约定推导，其余项都有
#  内置默认值。下面的变量只用于便携模式、调试或打包定制。
#
#  用法：把需要覆盖的项取消注释后，在启动应用前设置同名环境变量。
# ============================================================================

# ------------------------------------------------------------------- 日志
# 日志写入 $BUNKR_DATA_DIR/bunkr.log（未设置时用系统约定目录）
# BUNKR_LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------- 路径
# 留空时的默认位置：
#   数据（数据库 / aria2 会话 / 日志）
#     Windows  %APPDATA%/BunkrDownloader
#     macOS    ~/Library/Application Support/BunkrDownloader
#     Linux    $XDG_CONFIG_HOME/bunkrdownloader
#   下载文件  ~/Downloads/BunkrDownloader
# BUNKR_DATA_DIR=
# BUNKR_DOWNLOAD_DIR=
# BUNKR_DB=

# ------------------------------------------------------------- 账号与配额
# 留空时会自动生成并持久化到 $BUNKR_DATA_DIR/.jwt_secret
# BUNKR_JWT_SECRET=
# BUNKR_JWT_TTL=720h

# 免费用户额度
# BUNKR_FREE_LINKS_LIMIT=5             # 最多添加的链接数
# BUNKR_FREE_FILES_LIMIT=50            # 最多下载的文件数
# BUNKR_FREE_CONCURRENCY=1             # 同时运行的任务数
# 会员并发任务数
# BUNKR_MEMBER_CONCURRENCY=5

# ------------------------------------------------------------------- aria2
# 显式指定 aria2c；留空时按「可执行文件同级目录 → PATH → 自动下载」查找
# BUNKR_ARIA2_BIN=
# 找不到时是否自动下载官方二进制（Windows / macOS 有效）
# BUNKR_ARIA2_AUTO_FETCH=true
# BUNKR_ARIA2_SECRET=bunkr-desktop
# BUNKR_ARIA2_MAX_CONCURRENT=16

# ---------------------------------------------------------------- 会员支付
# true：点击「立即开通」后模拟网关直接置为已支付
# BUNKR_PAYMENT_AUTO=true

# ------------------------------------------------------------ Bunkr 接口
# 默认使用官方服务；对接镜像时覆盖以下三项
# BUNKR_SIGN_API=https://glb-apisign.cdn.cr/sign
# BUNKR_DOWNLOAD_API=https://dl.bunkr.cr/api/_001_v2
# BUNKR_DOWNLOAD_REFERER=https://dl.bunkrr.cr/
# 抓取页面时使用的 User-Agent
# BUNKR_USER_AGENT=Mozilla/5.0
