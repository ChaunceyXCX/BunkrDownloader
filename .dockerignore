# ============================================================================
#  BunkrDownloader · docker build context
#  Keep the context small: the image is built from sources, never from a
#  pre-existing node_modules or a previously built SPA.
# ============================================================================

# --- version control / IDE ---------------------------------------------------
.git
.gitignore
.github
.gitattributes
.kilo
.vscode
.idea
*.swp
*.swo

# --- Go build artifacts ------------------------------------------------------
bin/
*.exe
*.test
*.out
coverage.*
internal/web/dist/*
!internal/web/dist/.gitkeep

# --- frontend ----------------------------------------------------------------
frontend/node_modules
frontend/dist
frontend/.vite
frontend/npm-debug.log*
frontend/.env
frontend/.env.local

# --- python leftovers from the pre-go layout --------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- runtime data ------------------------------------------------------------
data/
downloads/
*.db
*.db-shm
*.db-wal
*.log
*.session
aria2-session.txt

# --- docs & misc -------------------------------------------------------------
*.md
!README.md
!docs/*.md
.kilo/
scripts/
assets/
Makefile
.env
.env.*
!.env.example
